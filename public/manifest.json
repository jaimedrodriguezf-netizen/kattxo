{
  "manifest_version": 3,
  "name": "Kattxo - Descarga Masiva SRI (XML & RIDE)",
  "version": "1.0.4",
  "description": "Descarga masiva de comprobantes electrónicos (Facturas, Retenciones, NC, ND, Liquidaciones) desde SRI en Línea para Kattxo",
  "permissions": [
    "storage",
    "downloads",
    "notifications",
    "activeTab"
  ],
  "host_permissions": [
    "https://srienlinea.sri.gob.ec/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://srienlinea.sri.gob.ec/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kattxo Descarga Masiva SRI"
  }
}
